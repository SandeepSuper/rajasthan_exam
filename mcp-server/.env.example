# Copy this file to .env and fill in real values. Never commit .env.

# Backend base URL (https, no trailing slash, no credentials in the URL)
API_BASE_URL=https://your-app.development.catalystappsail.in

# Admin login used by POST /api/admin-auth/login
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Write/delete tools stay OFF unless this is exactly "true"
ENABLE_WRITE_TOOLS=false

# Transport: "stdio" (Claude Code / Desktop, default) or "http" (claude.ai connector)
MCP_TRANSPORT=stdio

# HTTP only: secret path, the endpoint becomes /mcp/<MCP_PATH_SECRET>
# At least 32 chars, letters/digits/-/_ only. Generate a new random one, never reuse.
MCP_PATH_SECRET=replace-with-a-long-random-secret-of-48-characters

# Optional
# PORT=3000                 (AppSail sets X_ZOHO_CATALYST_LISTEN_PORT itself)
# REQUEST_TIMEOUT_MS=60000
# MAX_OUTPUT_CHARS=50000
